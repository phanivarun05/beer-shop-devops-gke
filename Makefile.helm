# ============================================================
# Beer Shop Helm Makefile
# ============================================================

NAMESPACE := beer-shop
HELM := helm
CHART_DIR := helm/beer-shop/charts

# ============================================================
# Infrastructure
# ============================================================

infra: mysql redis mongodb kafka consul jaeger

mysql:
	$(HELM) upgrade --install mysql $(CHART_DIR)/mysql -n $(NAMESPACE)

redis:
	$(HELM) upgrade --install redis $(CHART_DIR)/redis -n $(NAMESPACE)

mongodb:
	$(HELM) upgrade --install mongodb $(CHART_DIR)/mongodb -n $(NAMESPACE)

kafka:
	$(HELM) upgrade --install kafka $(CHART_DIR)/kafka -n $(NAMESPACE)

consul:
	$(HELM) upgrade --install consul $(CHART_DIR)/consul -n $(NAMESPACE)

jaeger:
	$(HELM) upgrade --install jaeger $(CHART_DIR)/jaeger -n $(NAMESPACE)

# ============================================================
# Application Services
# ============================================================

catalog:
	$(HELM) upgrade --install catalog $(CHART_DIR)/catalog -n $(NAMESPACE)

user:
	$(HELM) upgrade --install user $(CHART_DIR)/user -n $(NAMESPACE)

payment:
	$(HELM) upgrade --install payment $(CHART_DIR)/payment -n $(NAMESPACE)

order:
	$(HELM) upgrade --install order $(CHART_DIR)/order -n $(NAMESPACE)

cart:
	$(HELM) upgrade --install cart $(CHART_DIR)/cart -n $(NAMESPACE)

shipping:
	$(HELM) upgrade --install shipping $(CHART_DIR)/shipping -n $(NAMESPACE)

courier:
	$(HELM) upgrade --install courier $(CHART_DIR)/courier -n $(NAMESPACE)

shop-interface:
	$(HELM) upgrade --install shop-interface $(CHART_DIR)/shop-interface -n $(NAMESPACE)

shop-admin:
	$(HELM) upgrade --install shop-admin $(CHART_DIR)/shop-admin -n $(NAMESPACE)

# ============================================================
# Front-end React apps
# ============================================================

web-shop:
	$(HELM) upgrade --install web-shop $(CHART_DIR)/web-shop -n $(NAMESPACE)

web-admin:
	$(HELM) upgrade --install web-admin $(CHART_DIR)/web-admin -n $(NAMESPACE)

# ============================================================
# Full Deployment
# ============================================================

all: infra catalog user payment order cart shipping courier shop-interface shop-admin web-shop web-admin

# ============================================================
# Utilities
# ============================================================

pods:
	kubectl get pods -n $(NAMESPACE)

svc:
	kubectl get svc -n $(NAMESPACE)

deploy:
	kubectl get deployments -n $(NAMESPACE)

cm:
	kubectl get configmaps -n $(NAMESPACE)

pvc:
	kubectl get pvc -n $(NAMESPACE)

events:
	kubectl get events -n $(NAMESPACE) --sort-by=.metadata.creationTimestamp

# ============================================================
# Logs
# ============================================================

logs-catalog:
	kubectl logs deployment/catalog -n $(NAMESPACE) --tail=100

logs-user:
	kubectl logs deployment/user -n $(NAMESPACE) --tail=100

logs-order:
	kubectl logs deployment/order -n $(NAMESPACE) --tail=100

logs-payment:
	kubectl logs deployment/payment -n $(NAMESPACE) --tail=100

logs-cart:
	kubectl logs deployment/cart -n $(NAMESPACE) --tail=100

logs-shipping:
	kubectl logs deployment/shipping -n $(NAMESPACE) --tail=100

logs-courier:
	kubectl logs deployment/courier -n $(NAMESPACE) --tail=100

# ============================================================
# Cleanup
# ============================================================

clean-app:
	-helm uninstall shop-admin -n $(NAMESPACE)
	-helm uninstall shop-interface -n $(NAMESPACE)
	-helm uninstall courier -n $(NAMESPACE)
	-helm uninstall shipping -n $(NAMESPACE)
	-helm uninstall cart -n $(NAMESPACE)
	-helm uninstall order -n $(NAMESPACE)
	-helm uninstall payment -n $(NAMESPACE)
	-helm uninstall user -n $(NAMESPACE)
	-helm uninstall catalog -n $(NAMESPACE)

clean-infra:
	-helm uninstall jaeger -n $(NAMESPACE)
	-helm uninstall consul -n $(NAMESPACE)
	-helm uninstall kafka -n $(NAMESPACE)
	-helm uninstall mongodb -n $(NAMESPACE)
	-helm uninstall redis -n $(NAMESPACE)
	-helm uninstall mysql -n $(NAMESPACE)

clean-web:
	-helm uninstall web-shop -n $(NAMESPACE)
	-helm uninstall web-admin -n $(NAMESPACE)

clean: clean-app clean-infra clean-web

# ============================================================
# Helm Validation
# ============================================================

lint-catalog:
	helm lint $(CHART_DIR)/catalog

template-catalog:
	helm template catalog $(CHART_DIR)/catalog

lint-mysql:
	helm lint $(CHART_DIR)/mysql

template-mysql:
	helm template mysql $(CHART_DIR)/mysql

# ============================================================
# Help
# ============================================================

help:
	@echo ""
	@echo "Infrastructure:"
	@echo "  make -f Makefile.helm infra"
	@echo ""
	@echo "Application:"
	@echo "  make -f Makefile.helm catalog"
	@echo "  make -f Makefile.helm user"
	@echo "  make -f Makefile.helm order"
	@echo ""
	@echo "Deploy everything:"
	@echo "  make -f Makefile.helm all"
	@echo ""
	@echo "Status:"
	@echo "  make -f Makefile.helm pods"
	@echo "  make -f Makefile.helm svc"
	@echo "  make -f Makefile.helm deploy"
	@echo ""
	@echo "Cleanup:"
	@echo "  make -f Makefile.helm clean"
	@echo ""

# ============================================================
# Install Beer-shop
# ============================================================

install-beer-shop:
	helm upgrade --install beer-shop \
	helm/beer-shop \
	-n beer-shop

install-beer-shop-dev:
	helm upgrade --install beer-shop \
	helm/beer-shop \
	-f helm/beer-shop/values-dev.yaml \
	-n beer-shop

install-beer-shop-prod:
	helm upgrade --install beer-shop \
	helm/beer-shop \
	-f helm/beer-shop/values-prod.yaml \
	-n beer-shop

# ============================================================
# CI Validation
# ============================================================

helm-lint:
	$(HELM) lint helm/beer-shop

helm-template:
	$(HELM) template beer-shop helm/beer-shop \
		-f helm/beer-shop/values-dev.yaml \
		> /tmp/beer-shop-rendered.yaml

# ============================================================
# Kubernetes Manifest Validation
# ============================================================

k8s-validate:
	$(HELM) template beer-shop helm/beer-shop \
		-f helm/beer-shop/values-dev.yaml \
		| kubeconform -strict -summary

helm-validate: helm-lint helm-template k8s-validate
	@echo "Helm and Kubernetes validation passed"